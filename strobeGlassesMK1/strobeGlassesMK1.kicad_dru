(version 1)

# Conservative JLCPCB, 2 layers, 1 oz, 1.0 mm FR4. Checked 2026-11-07.
# Global minima: 0.15 mm track/clearance, 0.25 mm copper to routed edge,
# 0.60/0.30 mm vias, 1.0 mm text with 0.15 mm strokes.
(rule "JLC SMD land spacing"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
  (constraint clearance (min 0.15mm)))
(rule "JLC PTH annular ring"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint annular_width (min 0.18mm)))
(rule "JLC PTH hole to unrelated copper"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.28mm)))
(rule "JLC drilled pad separation"
  (condition "A.Type == 'Pad' || B.Type == 'Pad'")
  (constraint hole_to_hole (min 0.45mm)))
(rule "JLC round NPTH drill"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_size (min 0.50mm)))
(rule "Standard through vias only"
  (constraint disallow micro_via blind_via buried_via))

# Keep these fabrication limits explicit even if an already-open KiCad window
# saves an older copy of the project defaults.
(rule "JLC via annular ring"
  (condition "A.Type == 'Via'")
  (constraint annular_width (min 0.15mm)))
# Printed ink clears routed edges and exposed pad openings. Do not compare
# silkscreen to covered copper, fabrication graphics or assembly courtyards.
(rule "JLC silk to routed edge"
  (condition "B.Layer == 'Edge.Cuts'")
  (constraint silk_clearance (min 0.15mm)))
(rule "JLC front silk to exposed pads"
  (condition "A.Layer == 'F.SilkS' && B.Type == 'Pad' && (B.Layer == 'F.Cu' || B.Pad_Type == 'Through-hole' || B.Pad_Type == 'NPTH, mechanical')")
  (constraint silk_clearance (min 0.15mm)))
(rule "JLC back silk to exposed pads"
  (condition "A.Layer == 'B.SilkS' && B.Type == 'Pad' && (B.Layer == 'B.Cu' || B.Pad_Type == 'Through-hole' || B.Pad_Type == 'NPTH, mechanical')")
  (constraint silk_clearance (min 0.15mm)))
(rule "JLC silkscreen text"
  (condition "A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS'")
  (constraint text_height (min 1.0mm))
  (constraint text_thickness (min 0.15mm)))
